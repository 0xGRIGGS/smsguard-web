# Copy to .env (or set these in your host's dashboard) and adjust the values.
# Never commit a real .env file.

# Session signing key — use a long random string, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SMSGUARD_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database path. On a host, point this at a persistent disk.
SMSGUARD_DATABASE=/data/smsguard.db

# Set to 1 once the site is served over HTTPS.
SMSGUARD_COOKIE_SECURE=1

# Set to 1 when running behind a reverse proxy (Render, Fly, nginx, ...).
SMSGUARD_TRUST_PROXY=1
